# GitHub personal access token. Bez niego serwer działa, ale trafia na dużo niższy
# anonimowy limit zapytań (60/h zamiast 5000/h) i nie widzi prywatnych repozytoriów.
GITHUB_TOKEN=

# Bazowy URL GitHub REST API. Zmień tylko dla GitHub Enterprise Server,
# np. https://github.twoja-firma.com/api/v3
GITHUB_API_URL=https://api.github.com

# Host i port dla trybu HTTP (src/http.ts).
HOST=0.0.0.0
PORT=8080
